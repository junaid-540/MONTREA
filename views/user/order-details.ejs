<%- include('../partials/user/header') %>

<body>
    <%- include('../partials/user/navbar') %>

    <div class="order-details-container">
        <!-- Back Button -->
        <a href="/orders" class="back-btn">
            <i class="fas fa-arrow-left me-2"></i> Back to Orders
        </a>

        <!-- Order Header -->
        <div class="order-header-card">
            <div class="header-content">
                <div>
                    <h1 class="page-title">Order Details</h1>
                    <p class="order-id-display">Order ID: <span><%= order.orderId %></span></p>
                </div>
                <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>">
                    <%= order.orderStatus %>
                </span>
            </div>

            <div class="order-timeline">
                <div class="timeline-item">
                    <% if (order.paymentStatus === 'Failed') { %>
                        <div class="timeline-label">Payment Failed</div>
                   <% } else { %> 
                    <div class="timeline-label">Order Placed</div>
                   <% } %>
                    <div class="timeline-value">
                        <%= new Date(order.placedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                </div>
                <% if (order.paymentStatus !== 'Failed') { %>
                <div class="timeline-item">
                    <div class="timeline-label">
                        <% if (order.orderStatus === 'Delivered' || order.orderStatus === 'Partially Delivered') { %>
                            Delivered On
                        <% } else if (order.orderStatus.includes('Cancelled')) { %>
                            Cancelled On
                        <% } else if (order.expectedDelivery) { %>
                            Expected Delivery
                        <% } else { %>
                            Delivery Date TBD
                        <% } %>
                    </div>
                    <div class="timeline-value">
                        <% if (order.expectedDelivery) { %>
                            <%= new Date(order.expectedDelivery).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        <% } else if (order.orderStatus.includes('Cancelled')) { %>
                            <%= new Date(order.cancelledAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        <% } else { %>
                            <span class="text-muted">Updating...</span>
                        <% } %>
                    </div>
                </div>
                <% } %>
                <div class="timeline-item">
                    <div class="timeline-label">Total Amount</div>
                    <div class="timeline-value total-amount">₹<%= Math.round(order.totalAmount) %></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Order Items -->
                <div class="section-card">
                    <% if (order.paymentStatus !== 'Failed') { %>
                    <div class="order-tracking">
                        <h3 class="tracking-title">Order Progress</h3>
                        <% if (!order.orderStatus.includes('Cancelled')) { %>
                            <div class="tracking-steps">
                                <div class="step <%= order.orderStatus === 'Placed' ? 'active' : (['Processing', 'Shipped', 'Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">1</div>
                                    <div class="step-label">Placed</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Processing' ? 'active' : (['Shipped', 'Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">2</div>
                                    <div class="step-label">Processing</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Shipped' ? 'active' : (['Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">3</div>
                                    <div class="step-label">Shipped</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Out for Delivery' ? 'active' : (['Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">4</div>
                                    <div class="step-label">Out for Delivery</div>
                                </div>
                                <div class="step <%= ['Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'active' : '' %>">
                                    <div class="step-circle">5</div>
                                    <div class="step-label">Delivered</div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="tracking-steps">
                                <div class="step <%= order.orderStatus === 'Placed' ? 'active' : (['Processing', 'Shipped', 'Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">1</div>
                                    <div class="step-label">Placed</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Processing' ? 'active' : (['Shipped', 'Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">2</div>
                                    <div class="step-label">Processing</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Shipped' ? 'active' : (['Out for Delivery', 'Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">3</div>
                                    <div class="step-label">Shipped</div>
                                </div>
                                <div class="step <%= order.orderStatus === 'Out for Delivery' ? 'active' : (['Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'completed' : '') %>">
                                    <div class="step-circle">4</div>
                                    <div class="step-label">Out for Delivery</div>
                                </div>
                                <div class="step <%= ['Delivered', 'Partially Delivered'].includes(order.orderStatus) ? 'active' : '' %>">
                                    <div class="step-circle">5</div>
                                    <div class="step-label">Delivered</div>
                                </div>
                            </div>
                            <div class="cancelled-track">
                                <i class="fas fa-ban"></i> Order <%= order.orderStatus %>
                            </div>
                        <% } %>
                    </div>
                    <% } %>
                    <h2 class="section-title">
                        <i class="fas fa-box me-2"></i>
                        Order Items
                    </h2>

                    <% order.items.forEach(item=> { %>
                    <div class="order-item-card" data-item-id="<%= item._id %>">
                        <div class="item-content">
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image"
                                onerror="this.src='https://via.placeholder.com/100x100/eee/ccc?text=No+Image'">

                            <div class="item-info">
                                <h3 class="item-name">
                                    <%= item.name %>
                                </h3>
                                <p class="item-specs">
                                    Color: <%= item.color %> | Size: <%= item.size %> | Qty: <%= item.quantity %>
                                </p>

                                <div class="item-pricing">
                                    <span class="current-price">₹<%= Math.round(item.discountedPriceAtPurchase) || Math.round(item.priceAtPurchase) %></span>
                                    <% if (item.discountedPriceAtPurchase && item.discountedPriceAtPurchase < item.priceAtPurchase) { %>
                                    <span class="original-price">₹<%= Math.round(item.priceAtPurchase) %></span>
                                    <% } %>
                                </div>

                                <!-- Item Status Badge -->
                                    <% if (order.paymentStatus !== 'Failed') { %>
                                        <span class="item-status-badge status-<%= item.itemStatus.toLowerCase().replace(/\s+/g, '-') %>">
                                            <%= item.itemStatus %>
                                        </span>
                                    <% } %>
                                    </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="item-actions">
                                        <% if ((item.itemStatus === 'Placed' || item.itemStatus === 'Processing') && order.paymentStatus !== 'Failed') { %>
                                        <button class="btn-action btn-cancel" onclick="openCancelModal('<%= item._id %>', '<%= item.name %>')">
                                            <i class="fas fa-times-circle me-2"></i>
                                            Cancel Item
                                        </button>
                                        <% } %>

                                        <% if (item.itemStatus === 'Delivered' && !item.returnRequested) { %>
                                        <button class="btn-action btn-return" onclick="openReturnModal('<%= item._id %>', '<%= item.name %>')">
                                            <i class="fas fa-undo me-2"></i>
                                            Return Item
                                        </button>
                                        <% } %>

                                        <!-- Show Return Requested Badge only if status is still 'requested' -->
                                        <% if (item.returnRequested && item.returnStatus === 'requested') { %>
                                        <span class="return-requested-badge">
                                            <i class="fas fa-clock me-2"></i>
                                            Return Requested
                                        </span>
                                        <% } %>
                                    </div>

                                    <!-- Cancel/Return Info -->
                                    <% if (item.itemStatus === 'Cancelled' && item.cancelReason) { %>
                                    <div class="status-info cancel-info">
                                        <i class="fas fa-info-circle me-2"></i>
                                        <strong>Cancellation Reason:</strong>
                                        <%= item.cancelReason %>
                                    </div>
                                    <% } %>

                                    <!-- Return Status Messages -->
                                    <% if (item.returnRequested) { %>
                                        <% if (item.returnStatus === 'requested') { %>
                                            <div class="status-info return-info return-requested">
                                                <i class="fas fa-clock me-2"></i>
                                                <strong>Return Status:</strong> Pending Review
                                                <% if (item.returnReason) { %>
                                                <br><strong>Reason:</strong> <%= item.returnReason %>
                                                <% } %>
                                            </div>
                                        <% } else if (item.returnStatus === 'approved' || item.returnStatus === 'completed') { %>
                                            <div class="status-info return-info return-approved">
                                                <i class="fas fa-check-circle me-2"></i>
                                                <strong>Return Status:</strong> <%= item.returnStatus === 'completed' ? 'Completed' : 'Approved' %>
                                                <% if (item.returnReason) { %>
                                                <!-- <br><strong>Reason:</strong> <%= item.returnReason %> -->
                                                <% } %>
                                                 <% 
                                                    
                                                    let itemShare = item.itemTotal / order.subtotal;
                                                    let refundAmount = item.itemTotal;
                                                    
                                                    if (order.couponApplied && order.discountAmount > 0 && order.subtotal > 0) {
                                                        let itemDiscountShare = order.discountAmount * itemShare;
                                                        refundAmount = item.itemTotal - itemDiscountShare;
                                                    }
                                                    
                                                    let taxShare = order.tax * itemShare;
                                                    let totalRefund = refundAmount + taxShare;
                                                    totalRefund = Math.max(0, Math.round(totalRefund * 100) / 100);
                                                %>
                                                <br><strong>Refund:</strong> 
                                                Amount of ₹<%= Math.round(totalRefund) %> <%= item.returnStatus === 'completed' ? 'credited to your wallet' : 'will be credited to your wallet' %>
                                                <% if (order.paymentMethod === 'COD') { %>
                                                    <br><small class="text-muted">(Your cash payment will be refunded to wallet)</small>
                                                <% } %>
                                            </div>
                                        <% } else if (item.returnStatus === 'rejected') { %>
                                            <div class="status-info return-info return-rejected">
                                                <i class="fas fa-times-circle me-2"></i>
                                                <strong>Return Request Rejected</strong>
                                                <% if (item.returnReason) { %>
                                                <!-- <br><strong>Your Reason:</strong> <%= item.returnReason %> -->
                                                <% } %>
                                                <% if (item.adminNotes) { %>
                                                <br><strong>Admin Note:</strong> <%= item.adminNotes %>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    <% } %>

                                    <!-- Review Section -->
                                    <% if (item.itemStatus === 'Delivered') { %>
                                        <div class="review-section mt-3">
                                            <% if (item.hasReviewed && item.review) { %>
                                                <div class="status-info review-submitted">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <i class="fas fa-star me-2" style="color: #ffc107;"></i>
                                                            <strong>Your Review:</strong> 
                                                            <div class="stars small mt-1">
                                                                <% for(let i = 1; i <= 5; i++) { %>
                                                                    <i class="fas fa-star<%= i > item.review.rating ? '-half-alt' : '' %>"></i>
                                                                <% } %>
                                                            </div>
                                                            <% if (item.review.reviewText) { %>
                                                                <p class="mb-0 mt-2"><%= item.review.reviewText %></p>
                                                            <% } %>
                                                            <small class="text-muted">
                                                                Reviewed on <%= new Date(item.review.createdAt).toLocaleDateString('en-IN', { 
                                                                    day: 'numeric', 
                                                                    month: 'short', 
                                                                    year: 'numeric' 
                                                                }) %>
                                                            </small>
                                                        </div>
                                                        <div class="review-actions">
                                                            <button class="btn btn-sm btn-outline-danger" 
                                                                    onclick="confirmDeleteReview('<%= item.review._id %>', '<%= item.name %>')">
                                                                <i class="fas fa-trash me-1"></i>Delete
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% } else { %>
                                                <button class="btn-action btn-review" onclick="openReviewModal('<%= item._id %>', '<%= item.name %>')">
                                                    <i class="fas fa-star me-2"></i>
                                                    Write a Review
                                                </button>
                                            <% } %>
                                        </div>
                                    <% } %>
                    </div>
                    <% }); %>

                    <!-- Cancel Entire Order -->
                    <% if ((order.orderStatus === 'Placed' || order.orderStatus === 'Processing') && order.paymentStatus !== 'Failed') { %>
                    <button class="btn-cancel-order" onclick="openCancelModal(null, 'entire order')">
                        <i class="fas fa-ban me-2"></i>
                        Cancel Entire Order
                    </button>
                    <% } %>
                </div>

                <!-- Shipping Address -->
                <div class="section-card">
                    <h2 class="section-title">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Shipping Address
                    </h2>
                    <div class="address-content">
                        <p class="address-name">
                            <%= order.shippingAddress.fullName %>
                        </p>
                        <p class="address-line">
                            <%= order.shippingAddress.addressLine1 %>
                        </p>
                        <% if (order.shippingAddress.addressLine2) { %>
                        <p class="address-line">
                            <%= order.shippingAddress.addressLine2 %>
                        </p>
                        <% } %>
                        <p class="address-line">
                            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %>
                        </p>
                        <p class="address-line">
                            <%= order.shippingAddress.country %>
                        </p>
                        <p class="address-phone">
                            <i class="fas fa-phone me-2"></i>
                            <%= order.shippingAddress.phone %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Payment Info -->
                <div class="section-card summary-card">
                    <h2 class="section-title">
                        <i class="fas fa-credit-card me-2"></i>
                        Payment Info
                    </h2>
                    <div class="payment-info">
                        <div class="info-row">
                            <span class="info-label">Method</span>
                            <span class="info-value">
                                <%= order.paymentMethod %>
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Status</span>
                            <span class="info-value payment-status-<%= order.paymentStatus.toLowerCase() %>">
                                <%= order.paymentStatus %>
                            </span>
                        </div>
                    </div>
                </div>

                <% if (order.paymentStatus === 'Failed') { %>
                <!-- Payment Required Section -->
                <div class="section-card summary-card">
                    <h2 class="section-title">
                        <i class="fas fa-exclamation-triangle me-2" style="color: #e74c3c;"></i>
                        Payment Required
                    </h2>
                    <div class="payment-failed">
                        <p class="failed-message">Payment failed. Retry to process your order.</p>
                        <button id="retryPaymentBtn" 
                                class="btn-retry"
                                data-amount="<%= order.totalAmount %>">
                            <i class="fas fa-redo me-2"></i>
                            Retry Payment
                        </button>
                    </div>
                </div>
                <% } %>

                <!-- Price Summary -->
                <div class="section-card summary-card">
                    <h2 class="section-title">Price Summary</h2>
                    <div class="price-breakdown">
                        <div class="price-row">
                            <span>Subtotal</span>
                            <span>₹<%= Math.round(order.subtotal) %></span>
                        </div>
                        <% if (order.couponApplied && order.discountAmount > 0) { %>
                            <div class="price-row discount-row" style="background: #f0fdf4; padding: 8px 0; margin: 8px -15px; padding-left: 15px; padding-right: 15px;">
                                <span style="color: #16a34a; font-weight: 500;">
                                    <i class="fas fa-tag me-1"></i>
                                    Coupon <%= order.code ? '(' + order.code + ')' : '' %>
                                </span>
                                <span style="color: #16a34a; font-weight: 600;">
                                    -₹<%= Math.round(order.discountAmount) %>
                                </span>
                            </div>
                            <% } %>
                        <div class="price-row">
                            <span>Tax (GST)</span>
                             <span>₹<%= Math.round(order.tax) %></span>
                        </div>
                        <div class="price-row">
                            <span>Shipping</span>
                            <span class="<%= order.shippingCharge === 0 ? 'text-success' : '' %>">
                                <%= order.shippingCharge === 0 ? 'FREE' : '₹' + Math.round(order.shippingCharge) %>
                            </span>
                        </div>
                        <% if (order.discount > 0) { %>
                        <div class="price-row discount-row">
                            <span>Discount</span>
                            <span>-₹<%= order.discount.toFixed(2) %></span>
                        </div>
                        <% } %>
                        <div class="price-row total-row">
                            <span>Total</span>
                            <span>₹<%= Math.round(order.totalAmount) %></span>
                        </div>
                    </div>
                </div>

                <!-- Download Invoice (Conditional) -->
                <% if (order.orderStatus === 'Delivered' || order.hasReturn) { %>
                <button class="btn-download-invoice" onclick="downloadInvoice('<%= order.orderId %>')">
                    <i class="fas fa-download me-2"></i>
                    Download Invoice
                </button>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Cancel Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cancel <span id="cancelTargetName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="modal-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Are you sure you want to cancel this <span id="cancelTargetType"></span>?
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Reason for cancellation (Optional)</label>
                        <textarea class="form-control" id="cancelReason" rows="3" placeholder="Tell us why you're cancelling..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Order</button>
                    <button type="button" class="btn btn-danger" id="confirmCancelBtn">
                        Yes, Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Return Modal -->
    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Return <span id="returnItemName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        Please provide a reason for the return. This helps us improve our service.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Reason for return <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="returnReason" rows="3" placeholder="Please describe the issue..." required></textarea>
                        <div class="invalid-feedback">Please provide a reason for return</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmReturnBtn">
                        Submit Return Request
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Modal -->
        <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Review <span id="reviewProductName"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="reviewForm">
                            <input type="hidden" id="reviewItemId" value="">
                            <input type="hidden" id="reviewOrderId" value="<%= order.orderId %>">
                            
                            <div class="rating-section mb-4">
                                <label class="form-label d-block mb-3">How would you rate this product?</label>
                                <div class="star-rating">
                                    <input type="radio" id="star5" name="rating" value="5">
                                    <label for="star5" title="5 stars">★</label>
                                    <input type="radio" id="star4" name="rating" value="4">
                                    <label for="star4" title="4 stars">★</label>
                                    <input type="radio" id="star3" name="rating" value="3">
                                    <label for="star3" title="3 stars">★</label>
                                    <input type="radio" id="star2" name="rating" value="2">
                                    <label for="star2" title="2 stars">★</label>
                                    <input type="radio" id="star1" name="rating" value="1">
                                    <label for="star1" title="1 star">★</label>
                                </div>
                                <div class="rating-text mt-2 text-muted small" id="ratingText">Tap a star to rate</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Your Review (Optional)</label>
                                <textarea class="form-control" id="reviewText" rows="4" 
                                        placeholder="Share your experience... (Maximum 1000 characters)"
                                        maxlength="1000"></textarea>
                                <div class="form-text text-end">
                                    <span id="charCount">0</span>/1000 characters
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="submitReviewBtn" disabled>
                            Submit Review
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Review Modal -->
        <div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Review</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="modal-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Are you sure you want to delete your review for 
                            <span id="deleteProductName" class="fw-bold"></span>?
                        </div>
                        <p class="mt-3 text-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            This action cannot be undone.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteReviewBtn">
                            Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>


    <%- include('../partials/user/footer') %>

    <% if (order.paymentStatus === 'Failed') { %>
    <!-- Razorpay Script for Retry -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <% } %>

    <script>
        // Order-specific flags for invoice download
        window.orderStatus = '<%= order.orderStatus %>';
        window.hasReturn = <%= order.hasReturn || false %>;
    </script>

    <script>
        const messages = <%- JSON.stringify(messages || []) %>;
        messages.forEach(msg => {
            let bgColor, duration = 3000;
            switch (msg.type) {
                case 'error':
                    bgColor = "linear-gradient(to right, #ff6b6b, #ee5a24)";
                    break;
                case 'success':
                    bgColor = "linear-gradient(to right, #00b09b, #96c93d)";
                    break;
                case 'warning':
                    bgColor = "linear-gradient(to right, #ffa726, #ff7043)";
                    duration = 4000;
                    break;
                default:
                    bgColor = "linear-gradient(to right, #2196f3, #21cbf3)";
            }
            Toastify({
                text: msg.text,
                duration: duration,
                gravity: "top",
                position: "right",
                backgroundColor: bgColor,
                stopOnFocus: true,
            }).showToast();
        });
    </script>