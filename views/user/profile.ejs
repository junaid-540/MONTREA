<%- include('../partials/user/header') %>
<body>

    <%- include('../partials/user/navbar') %>

    <!-- Main Content -->
    <div class="container py-4">
        <div class="row">
            <!-- Sidebar -->
            
             <%- include('../partials/user/sidebar') %>

            <!-- Profile Form -->
            <div class="col-lg-9">
                <div class="profile-card">
                    <h2 class="profile-title">Welcome <%= user.name %></h2>
                    
                    <!-- Profile Picture -->
                    <div class="profile-pic-container">
                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="Profile" class="profile-pic" style="object-fit: cover;">
                        <% } else { %>
                            <div class="profile-pic"></div>
                        <% } %>
                    </div>

                    <!-- Profile Info -->
                    <div class="profile-info">
                        <div class="row mb-4">
                            <label class="col-sm-3 col-form-label form-label">Name:</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" value="<%= user.name || '' %>" readonly>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <label class="col-sm-3 col-form-label form-label">Email:</label>
                            <div class="col-sm-9">
                                <input type="email" class="form-control" value="<%= user.email || '' %>" readonly>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <label class="col-sm-3 col-form-label form-label">Phone:</label>
                            <div class="col-sm-9">
                                <input type="tel" class="form-control" value="<%= user.phone || '' %>" readonly>
                            </div>
                        </div>

                        <!-- Buttons Row -->
                        <div class="row mt-5 buttons-row">
                            
                            <div class="<%= isGoogleUser ? 'col-12 d-flex justify-content-center' : 'col-md-6 d-flex justify-content-start' %> mb-3 mb-md-0">
                                <a href="/edit-profile" class="btn-edit">Edit</a>
                            </div>
                            
                            
                            <% if (!isGoogleUser) { %>
                                <div class="col-md-6 d-flex justify-content-end">
                                    <a href="/change-password" class="btn-change-password">Change password</a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <span id="successMsg" style="display:none;"><%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %></span>
    <span id="errorMsg" style="display:none;"><%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %></span>
    <%- include('../partials/user/footer') %>
