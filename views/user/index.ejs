<%- include('../partials/user/header') %>

    <body>
        <!-- Navbar -->
        <%- include('../partials/user/navbar') %>

            <!-- Hero Carousel -->
            <section class="hero-carousel">
                <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0"
                            class="active"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="/public/images/slide-01.jpg" class="d-block w-100" alt="Women Collection">
                            <div class="carousel-caption">
                                <h5 class="carousel-title">Women Collection 2025</h5>
                                <h2 class="carousel-heading">NEW SEASON</h2>
                                <a href="/shop?category=WOMEN" class="btn btn-carousel">Shop Now</a>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="/public/images/slide-02.jpg" class="d-block w-100" alt="Men New-Season">
                            <div class="carousel-caption">
                                <h5 class="carousel-title">Men’s Essentials 2025</h5>
                                <h2 class="carousel-heading">Classic Fits</h2>
                                <a href="/shop?category=MEN" class="btn btn-carousel">Shop Now</a>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="/public/images/slide-03.jpg" class="d-block w-100" alt="Men Collection">
                            <div class="carousel-caption">
                                <h5 class="carousel-title">Fresh Finds</h5>
                                <h2 class="carousel-heading">New arrivals</h2>
                                <a href="/shop?sort=newest" class="btn btn-carousel">Shop Now</a>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel"
                        data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel"
                        data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </section>

            <!-- Category Section -->
            <section class="category-section py-5">
                <div class="container">
                    <div class="text-center mb-5">
                        <h3 class="section-subtitle">EXPLORE</h3>
                        <h2 class="section-title">Shop by Category</h2>
                        <div class="title-underline"></div>
                    </div>
                    <div class="row g-4">
                        <% categories.slice(0, 3).forEach(category=> { %>
                            <div class="col-md-4 col-sm-4">
                                <div class="category-card">
                                    <div class="category-image">
                                        <img src="<%= category.image %>" alt="<%= category.name %>">
                                        <div class="category-overlay">
                                            <h3 class="category-name">
                                                <%= category.name %>
                                            </h3>
                                            <a href="/shop?category=<%= category.name %>" class="btn-category">Shop
                                                Now</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </section>

            <!-- New Arrivals Section -->
            <section id="new-arrivals" class="new-arrivals-section py-5 bg-light">
                <div class="container">
                    <div class="text-center mb-5">
                        <h3 class="section-subtitle">DISCOVER</h3>
                        <h2 class="section-title">New Arrivals</h2>
                        <div class="title-underline"></div>
                    </div>
                    <div class="row g-4">
                        <% newArrivals.forEach(product=> { %>
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="product-card">
                                    <div class="product-image">
                                        <img src="<%= product.image %>" alt="<%= product.name %>">
                                        <div class="product-badge">New</div>
                                        <div class="product-overlay">
                                            <a href="/product/<%= product._id %>" class="btn-view">Quick View</a>
                                        </div>
                                    </div>
                                    <div class="product-info">
                                        <h5 class="product-name">
                                            <%= product.name %>
                                        </h5>
                                        <p class="product-price">₹<%= product.price %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </section>

            <!-- Promotional Banner -->
            <section class="promo-banner">
                <div class="promo-image"
                    style="background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1600&h=500&fit=crop');">
                    <div class="promo-overlay">
                        <div class="container">
                            <!-- <div class="promo-content">
                        <h5 class="promo-subtitle">Limited Edition</h5>
                        <h2 class="promo-title">Exclusive Collection</h2>
                        <p class="promo-text">Get your hands on our limited edition pieces before they're gone</p>
                        <a href="/products" class="btn btn-promo">Explore Collection</a>
                    </div> -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- Featured Products Section -->
            <section id="shop" class="featured-section py-5">
                <div class="container">
                    <div class="text-center mb-5">
                        <h3 class="section-subtitle">TRENDING</h3>
                        <h2 class="section-title">Featured Products</h2>
                        <div class="title-underline"></div>
                    </div>
                    <div class="row g-4">

                        <% if (featuredProducts && featuredProducts.length> 0) { %>
                            <% featuredProducts.forEach(product=> { %>
                                <div class="col-lg-3 col-md-6 col-sm-6">
                                    <div class="product-card">
                                        <div class="product-image">
                                            <img src="<%= product.image %>" alt="<%= product.name %>">
                                            <div class="product-overlay">
                                                <a href="/product/<%= product._id %>" class="btn-view">Quick View</a>
                                            </div>
                                        </div>
                                        <div class="product-info">
                                            <h5 class="product-name">
                                                <%= product.name %>
                                            </h5>
                                            <p class="product-price">₹<%= product.price %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p>No featured products available yet.</p> <!-- Fallback message -->
                                        <% } %>
                    </div>
                </div>
            </section>

            <!-- Footer -->
            <script>
                const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
                const errorMessage = "<%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %>";
            </script>
            <%- include('../partials/user/footer') %>
    </body>