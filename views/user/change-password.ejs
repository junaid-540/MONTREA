<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password - MONTRÉA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Arial', sans-serif;
        }

        .left-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(135deg,
                    rgba(255, 255, 255, 0.1),
                    rgba(255, 255, 255, 0.1) 2px,
                    transparent 2px,
                    transparent 20px);
            opacity: 0.5;
        }

        .form-container {
            max-width: 100%;
            width: 100%;
        }

        .change-title {
            font-size: 1.8rem;
            font-weight: bold;
            text-align: left;
            margin-bottom: 2rem;
            color: #000;
        }

        .form-label {
            font-size: 0.9rem;
            font-weight: 400;
            color: #999;
            margin-bottom: 0.5rem;
        }

        .form-control {
            height: 3rem;
            border-radius: 0.375rem;
            border: 1px solid #ddd;
            padding: 0.75rem 1rem;
        }

        .password-input {
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
        }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.15);
        }

        .password-toggle {
            cursor: pointer;
            font-size: 1.2rem;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem;
            min-width: 3rem;
            background: transparent;
            border: 1px solid #ddd;
            border-left: none;
            outline: none;
        }

        .password-toggle:hover {
            color: #374151;
            background: transparent;
            border-color: #ddd;
            border-left: none;
        }

        .password-toggle:focus {
            box-shadow: none;
            background: transparent;
            border-color: #a47f5f;
            border-left: none;
        }

        /* Error styling */
        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .text-danger.text-sm {
            font-size: 0.875rem;
        }

        .submit-btn {
            background-color: #000;
            border: none;
            height: 3rem;
            font-size: 0.95rem;
            margin-top: 1rem;
            margin-bottom: 0.7rem;
        }

        .submit-btn:hover {
            background-color: #a47f5f;
        }

        .forgot-link {
            font-size: 0.8rem;
            display: flex;
            ;
            justify-content: center;

        }

        .forgot-link a {
            text-decoration: none;
        }

        .forgot-link a:hover {
            text-decoration: underline;
            color: blue;
        }

        .brand-footer {
            font-style: italic;
            position: absolute;
            bottom: 1rem;
            right: 1rem;
            font-weight: bold;
            color: #000;
        }

        /* .breadcrumb-nav { 
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 10;
}


.breadcrumb {
    margin: 0;
    padding: 0;
    background: transparent;
}


.breadcrumb-back {
    color: #333;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
}


.breadcrumb-back:hover {
    text-decoration: underline;
    color: #a47f5f;
}  */


        @media (max-width: 992px) {
            .brand-footer {
                position: static;
                text-align: center;
                margin-top: 1.5rem;
            }

            .change-title {
                font-size: 1.5rem;
            }
        }

        @media (max-width: 767px) {
            .form-container {
                max-width: 100%;
            }

            .row .col {
                margin-bottom: 0.5rem;
            }

            .change-title {
                font-size: 1.3rem;
            }

        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center vh-100">



    <div class="container">

        <div class="row shadow-lg rounded-4 overflow-hidden">
            <!-- <nav aria-label="breadcrumb" class="breadcrumb-nav">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/profile" class="breadcrumb-back">← Go back</a>
            </li>
        </ol>
        </nav> -->

            <!-- Left side - Image -->
            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center left-bg">
                <img src="/public/images/brand_logo-new.png" alt="MONTRÉA Logo" class="img-fluid p-5">
            </div>

            <!-- Right side - Change Password Form -->
            <div class="col-lg-6 col-md-12 bg-white p-5 d-flex flex-column justify-content-center position-relative">
                <div class="form-container">
                    <h2 class="change-title">Change Password</h2>

                    <form id="changePasswordForm" class="needs-validation" method="POST" action="/change-password">
                        <div class="mb-3">
                            <label for="oldPassword" class="form-label">Enter old password</label>
                            <div class="input-group">
                                <input type="password" class="form-control password-input" id="oldPassword"
                                    name="oldPassword" autocomplete="current-password">
                                <button class="btn btn-outline-secondary password-toggle" type="button"
                                    id="oldPasswordToggle">👁️</button>
                            </div>
                            <div id="oldPasswordFeedback" class="invalid-feedback">Please enter your old password.</div>
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">New Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control password-input" id="newPassword"
                                    name="newPassword" autocomplete="new-password">
                                <button class="btn btn-outline-secondary password-toggle" type="button"
                                    id="newPasswordToggle">👁️</button>
                            </div>
                            <div id="newPasswordFeedback" class="invalid-feedback">Please enter a new password.</div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirmation Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control password-input" id="confirmPassword"
                                    name="confirmPassword" autocomplete="new-password">
                                <button class="btn btn-outline-secondary password-toggle" type="button"
                                    id="confirmPasswordToggle">👁️</button>
                            </div>
                            <div id="confirmPasswordFeedback" class="invalid-feedback">Passwords do not match.</div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 submit-btn">Submit</button>
                    </form>

                    <!-- Error message display -->
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger mt-3">
                            <%= error %>
                        </div>
                        <% } %>

                            <!-- <p class="forgot-link mt-1"><a href="/forgot-password">Forgot Password?</a></p> -->
                            <!-- Success message display -->
                            <% if (typeof success !=='undefined' && success) { %>
                                <div class="alert alert-success mt-3">
                                    <%= success %>
                                </div>
                                <% } %>


                                    <div class="text-center mt-3">
                                        <p class="text-muted mb-2">Forgot your current password?</p>
                                        <button type="button" id="forgotCurrentPasswordBtn"
                                            class="btn btn-outline-danger btn-sm">
                                            Reset via Email OTP
                                        </button>
                                    </div>

                </div>

                <div class="text-center mt-4 fw-bold brand-footer">MONTRÉA</div>
            </div>
        </div>
    </div>

    <script>
        const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
        const errorMessage = "<%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %>";
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {


            document.getElementById("forgotCurrentPasswordBtn").addEventListener("click", async () => {
                const result = await Swal.fire({
                    title: 'Reset Password?',
                    text: 'Send password reset OTP to your registered email?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#1100ff',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, send OTP',
                    cancelButtonText: 'Cancel'
                });

                if (!result.isConfirmed) return;

                try {
                    const res = await axios.get("/profile/forgot-current-password");
                    if (res.data.success) {
                        Toastify({
                            text: res.data.message || "OTP sent! Check your email.",
                            backgroundColor: "#4CAF50",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                        }).showToast();
                        setTimeout(() => window.location.href = "/verify-forgot-otp", 1500);
                    }
                } catch (err) {
                    const msg = err.response?.data?.message || "Something went wrong.";
                    Toastify({
                        text: msg,
                        backgroundColor: "#f44336",
                        duration: 4000,
                        gravity: "top",
                        position: "right",
                    }).showToast();
                }
            });


            const form = document.getElementById("changePasswordForm");
            const oldPasswordInput = document.getElementById("oldPassword");
            const newPasswordInput = document.getElementById("newPassword");
            const confirmPasswordInput = document.getElementById("confirmPassword");



            const oldToggle = document.getElementById("oldPasswordToggle");
            const newToggle = document.getElementById("newPasswordToggle");
            const confirmToggle = document.getElementById("confirmPasswordToggle");

            const oldFeedback = document.getElementById("oldPasswordFeedback");
            const newFeedback = document.getElementById("newPasswordFeedback");
            const confirmFeedback = document.getElementById("confirmPasswordFeedback");

            // Toggle password visibility
            function setupToggle(toggleBtn, input) {
                toggleBtn.addEventListener("click", () => {
                    if (input.type === "password") {
                        input.type = "text";
                        toggleBtn.innerHTML = `<img src="/public/images/hide.png" alt="hide" style="width:18px;height:18px;">`;
                    } else {
                        input.type = "password";
                        toggleBtn.innerHTML = "👁️";
                    }
                });
            }

            setupToggle(oldToggle, oldPasswordInput);
            setupToggle(newToggle, newPasswordInput);
            setupToggle(confirmToggle, confirmPasswordInput);

            // Validation Functions
            function validateOldPassword(pwd) {
                if (!pwd) return "Please enter your current password";
                if (pwd.length < 6) return "Current password is too short";
                return null;
            }

            function validateNewPassword(pwd) {
                const regex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{6,50}$/;
                if (!pwd) return "New password is required";
                if (pwd.length < 6) return "Password must be at least 6 characters";
                if (!regex.test(pwd)) return "Password must contain letters and numbers";
                if (pwd === oldPasswordInput.value) return "New password must be different";
                return null;
            }

            function validateConfirmPassword(pwd) {
                if (!pwd) return "Please confirm your new password";
                if (pwd !== newPasswordInput.value) return "Passwords do not match";
                return null;
            }

            function showError(input, feedback, msg) {
                input.classList.add("is-invalid");
                feedback.textContent = msg;
                feedback.style.display = "block";
            }

            function hideError(input, feedback) {
                input.classList.remove("is-invalid");
                feedback.textContent = "";
                feedback.style.display = "none";
            }

            // Real-time validation
            oldPasswordInput.addEventListener("blur", () => {
                const err = validateOldPassword(oldPasswordInput.value);
                err ? showError(oldPasswordInput, oldFeedback, err) : hideError(oldPasswordInput, oldFeedback);
            });

            newPasswordInput.addEventListener("blur", () => {
                const err = validateNewPassword(newPasswordInput.value);
                err ? showError(newPasswordInput, newFeedback, err) : hideError(newPasswordInput, newFeedback);
                // Revalidate confirm if already typed
                if (confirmPasswordInput.value) validateConfirmPassword(confirmPasswordInput.value);
            });

            confirmPasswordInput.addEventListener("blur", () => {
                const err = validateConfirmPassword(confirmPasswordInput.value);
                err ? showError(confirmPasswordInput, confirmFeedback, err) : hideError(confirmPasswordInput, confirmFeedback);
            });

            // Clear error on focus
            [oldPasswordInput, newPasswordInput, confirmPasswordInput].forEach(input => {
                input.addEventListener("focus", () => {
                    const feedback = document.getElementById(input.id + "Feedback");
                    hideError(input, feedback);
                });
            });

            // Form Submit
            form.addEventListener("submit", async function (e) {
                e.preventDefault();

                let isValid = true;
                const errors = [
                    [oldPasswordInput, oldFeedback, validateOldPassword(oldPasswordInput.value)],
                    [newPasswordInput, newFeedback, validateNewPassword(newPasswordInput.value)],
                    [confirmPasswordInput, confirmFeedback, validateConfirmPassword(confirmPasswordInput.value)],
                ];

                errors.forEach(([input, feedback, err]) => {
                    if (err) {
                        showError(input, feedback, err);
                        isValid = false;
                    } else {
                        hideError(input, feedback);
                    }
                });

                if (!isValid) return;

                const formData = new FormData(form);

                try {
                    const response = await axios.post("/change-password", {
                        oldPassword: oldPasswordInput.value.trim(),
                        newPassword: newPasswordInput.value.trim(),
                        confirmPassword: confirmPasswordInput.value.trim()
                    });  // => should i give the formData here instead of these three

                    if (response.data.success) {
                        Swal.fire({
                            icon: "success",
                            timer: 3000,
                            title: "Success!",
                            text: response.data.message || "Password changed successfully!",
                            confirmButtonColor: "#1100ff",
                            timerProgressBar: true,

                        }).then(() => {
                            window.location.href = "/profile";
                        });
                    }
                } catch (error) {
                    const msg = error.response?.data?.message || "Something went wrong.";
                    if (msg.includes("incorrect") || msg.includes("current")) {
                        showError(oldPasswordInput, oldFeedback, msg)
                        return;
                    }
                    Toastify({
                        text: msg,
                        duration: 4000,
                        gravity: "top",
                        position: "right",
                        backgroundColor: "linear-gradient(to right, #ff5f6d, #ffc371)",
                    }).showToast();
                }
            });
        });
    </script>
</body>

</html>