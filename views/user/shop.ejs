<%- include('../partials/user/header') %>
    <%- include('../partials/user/navbar') %>

        <body>
            <!-- Hero Section -->
            <section class="hero-section">
                <div class="container">
                    <h1>JUST FOR YOU</h1>
                    <p>Refresh Your Everyday Look Or Try Something Standout. Explore The Full Range.</p>
                </div>
            </section>


            <!-- Filter & Sort Section -->
            <section class="filter-section">
                <div class="container">
                    <form id="filterForm" method="GET">
                        <div class="row align-items-center">
                            <div class="col-md-9">
                                <div class="d-flex flex-wrap gap-2">
                                    <!-- Size Filter -->
                                    <div class="dropdown">
                                        <button class="btn btn-filter dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown">
                                            Size
                                        </button>
                                        <ul class="dropdown-menu filter-dropdown">
                                            <% sizes.forEach(size=> { %>
                                                <li><label class="dropdown-item"><input type="checkbox" name="size"
                                                            value="<%= size %>" <%=(selectedFilters.size &&
                                                            selectedFilters.size.includes(size)) ? 'checked' : '' %>>
                                                        <%= size %>
                                                    </label></li>
                                                <% }) %>
                                        </ul>
                                    </div>

                                    <!-- Color Filter -->
                                    <div class="dropdown">
                                        <button class="btn btn-filter dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown">
                                            Colors
                                        </button>
                                        <ul class="dropdown-menu filter-dropdown">
                                            <% colors.forEach(color=> { %>
                                                <li><label class="dropdown-item"><input type="checkbox" name="color"
                                                            value="<%= color %>" <%=(selectedFilters.color &&
                                                            selectedFilters.color.includes(color)) ? 'checked' : '' %>>
                                                        <%= color %>
                                                    </label></li>
                                                <% }) %>
                                        </ul>
                                    </div>

                                    <!-- Category Filter -->
                                    <div class="dropdown">
                                        <button class="btn btn-filter dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown">
                                            Categories
                                        </button>
                                        <ul class="dropdown-menu filter-dropdown">
                                            <% const selectedCats=selectedFilters.category ?
                                                selectedFilters.category.split(',').map(c=> c.trim().toUpperCase()) :
                                                []; // Split & normalize upper for match
                                                %>
                                                <% categories.forEach(cat=> {
                                                    const catUpper = cat.name.toUpperCase(); // Normalize DB name
                                                    %>
                                                    <li><label class="dropdown-item"><input type="checkbox"
                                                                name="category" value="<%= cat.name %>"
                                                                <%=selectedCats.includes(catUpper) ? 'checked' : '' %>>
                                                            <%= cat.name %></label></li>
                                                    <% }) %>
                                        </ul>
                                    </div>

                                    <!-- Price Filter (Radios for exclusive ranges) -->
                                    <div class="dropdown">
                                        <button class="btn btn-filter dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown">
                                            Price
                                        </button>
                                        <ul class="dropdown-menu filter-dropdown">
                                            <li><label class="dropdown-item"><input type="radio" name="priceRange"
                                                        value="0-1000" <%=selectedFilters.priceRange==='0-1000'
                                                        ? 'checked' : '' %>> Under ₹1000</label></li>
                                            <li><label class="dropdown-item"><input type="radio" name="priceRange"
                                                        value="1000-2000" <%=selectedFilters.priceRange==='1000-2000'
                                                        ? 'checked' : '' %>> ₹1000 - ₹2000</label></li>
                                            <li><label class="dropdown-item"><input type="radio" name="priceRange"
                                                        value="2000-3000" <%=selectedFilters.priceRange==='2000-3000'
                                                        ? 'checked' : '' %>> ₹2000 - ₹3000</label></li>
                                            <li><label class="dropdown-item"><input type="radio" name="priceRange"
                                                        value="3000-max" <%=selectedFilters.priceRange==='3000-max'
                                                        ? 'checked' : '' %>> Above ₹3000</label></li>
                                        </ul>
                                    </div>

                                    <button type="button" class="btn-clear" id="clearAll">CLEAR ALL</button>
                                </div>
                            </div>

                            <div class="col-md-3 text-end">

                                <select class="form-select" id="sortBy" name="sort"
                                    style="width: auto; display: inline-block;">
                                    <option value="" <%=!selectedFilters.sort ? 'selected' : '' %>>Sort By</option>
                                    <option value="newest" <%=selectedFilters.sort==='newest' ? 'selected' : '' %>
                                        >Newest First</option>
                                    <option value="priceLow" <%=selectedFilters.sort==='priceLow' ? 'selected' : '' %>
                                        >Price: Low to High</option>
                                    <option value="priceHigh" <%=selectedFilters.sort==='priceHigh' ? 'selected' : '' %>
                                        >Price: High to Low</option>
                                    <option value="aToZ" <%=selectedFilters.sort==='aToZ' ? 'selected' : '' %>
                                        >Alphabetical: A-Z</option>
                                </select>
                            </div>
                        </div>
                        <!-- Hidden input to preserve pagination -->
                        <input type="hidden" name="page" value="<%= pagination?.currentPage || 1 %>">
                    </form>
                </div>
            </section>

            <!-- Products Section -->
            <section class="products-section">
                <div class="container">
                    <div class="row g-4">
                        <% if (products && products.length> 0) { %>
                            <% products.forEach(product=> { %>
                                <div class="col-lg-3 col-md-6 col-sm-6">
                                    <div class="product-card">
                                        <a href="/product/<%= product._id %>" class="product-link">
                                            <div class="product-image-container">
                                                <img src="<%= product.coverImage.url || '/public/images/placeholder.png' %>"
                                                    alt="<%= product.name %>" class="product-image">
                                                <div class="wishlist-icon">
                                                    <i class="far fa-heart"></i>
                                                </div>
                                            </div>
                                        </a>

                                        <div class="product-info">
                                            <p class="product-category">
                                                <%= product.categoryId?.name || 'Uncategorized' %>
                                            </p>

                                            <h5 class="product-title">
                                                <a href="/product/<%= product._id %>">
                                                    <%= product.name %>
                                                </a>
                                            </h5>

                                            <% if (product.variants && product.variants.length> 0) { %>
                                                <% const prices=product.variants.map(v=> v.price);
                                                    const minPrice = Math.min(...prices);
                                                    const maxPrice = Math.max(...prices);
                                                    %>
                                                    <div class="product-pricing">
                                                        <span class="price-current">₹ <%= minPrice.toLocaleString() %>
                                                        </span>
                                                        <% if (minPrice !==maxPrice) { %>
                                                            <span class="price-original">₹ <%= maxPrice.toLocaleString()
                                                                    %></span>
                                                            <% } %>
                                                    </div>

                                                    <!-- Variant Colors -->
                                                    <div class="variant-colors mt-2 d-flex flex-wrap gap-1">
                                                        <% product.variants.forEach(v=> {
                                                            const rawColor = v && v.color ? String(v.color).trim() : '';
                                                            const safeColor = rawColor ?
                                                            rawColor.toLowerCase().replace(/\s+/g, '') : '#ccc';
                                                            %>
                                                            <span class="color-dot"
                                                                style="background-color:<%= safeColor %>;
                                                                title="<%= rawColor || 'No color' %>"></span>
                                                            <% }) %>
                                                    </div>

                                                    <% } else { %>
                                                        <p class="product-price">Price N/A</p>
                                                        <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-12">
                                            <p class="text-center no-products">No products found.</p>
                                        </div>
                                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination && pagination.totalPages> 1) { %>
                        <nav>
                            <ul class="pagination justify-content-center mt-5">
                                <% if (pagination.currentPage> 1) { %>
                                    <li class="page-item">
                                        <% const prevParams=new URLSearchParams(query); prevParams.set('page',
                                            pagination.currentPage - 1); %>
                                            <a class="page-link" href="?<%= prevParams.toString() %>">Previous</a>
                                    </li>
                                    <% } %>

                                        <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                                <% const params=new URLSearchParams(query); params.set('page', i); %>
                                                    <a class="page-link" href="?<%= params.toString() %>">
                                                        <%= i %>
                                                    </a>
                                            </li>
                                            <% } %>

                                                <% if (pagination.currentPage < pagination.totalPages) { %>
                                                    <li class="page-item">
                                                        <% const nextParams=new URLSearchParams(query);
                                                            nextParams.set('page', pagination.currentPage + 1); %>
                                                            <a class="page-link"
                                                                href="?<%= nextParams.toString() %>">Next</a>
                                                    </li>
                                                    <% } %>
                            </ul>
                        </nav>
                        <% } %>
                </div>
            </section>

            <%- include('../partials/user/footer') %>
        </body>