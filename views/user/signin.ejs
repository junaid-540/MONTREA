<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In to MONTRÉA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="/public/css/user/signin.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
</head>

<body class="d-flex align-items-center justify-content-center vh-100">

    <div class="container">
        <div class="row shadow-lg rounded-4 overflow-hidden">

            <!-- Left side - Image -->
            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center left-bg">
                <img src="/public/images/brand_logo-new.png" alt="MONTRÉA Logo" class="img-fluid p-5">
            </div>

            <!-- Right side - Signin Form -->
            <div class="col-lg-6 col-md-12 bg-white p-5 d-flex flex-column justify-content-center position-relative">
                <div class="form-container">
                    <h5 class="brand-small">MONTRÉA</h5>
                    <h2 class="signup-title">Sign In to MONTRÉA</h2>

                    <a href="/auth/google" class="btn btn-outline-secondary w-100 mb-3 google-btn">
                        <img src="https://www.google.com/favicon.ico" alt="Google Icon" class="google-icon me-2">
                        Sign in with Google
                    </a>
                    <div class="or-divider my-3">- OR -</div>

                    <form id="signinForm" class="needs-validation" method="POST" action="/signin">
                        <div class="mb-3">
                            <input type="email" class="form-control email-input" id="email" name="email" autocomplete="email" placeholder="Email Address">
                            <div id="emailFeedback" class="invalid-feedback">Please enter a valid email.</div>
                        </div>
                        <div class="mb-3">
                            <div class="input-group">
                                <input type="password" class="form-control" id="password" name="password" autocomplete="new-password" placeholder="Password">
                                <button class="btn btn-outline-secondary password-toggle" type="button" id="passwordToggle">👁️</button>
                            </div>
                            <div id="passwordFeedback" class="invalid-feedback">Please enter a password.</div>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 create-btn">Sign In</button>
                    </form>

                    <!-- Error message display -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger mt-3">
                            <%= error %>
                        </div>
                    <% } %>

                    <p class="login-link mt-3">Don't have an account? <a href="/signup">Register Now</a></p>
                    <p class="forgot-link mt-1"><a href="/forgot-password">Forgot Password?</a></p>
                </div>

                <div class="text-center mt-4 fw-bold brand-footer">MONTRÉA</div>
            </div>
        </div>
    </div>

    <script>
        const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
        const errorMessage = "<%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %>";
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/public/js/user/signin.js"></script>
</body>

</html>