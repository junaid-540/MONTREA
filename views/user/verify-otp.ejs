<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OTP Verification - MONTRÉA</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link rel="stylesheet" href="/public/css/user/verify-otp.css">
</head>
<body>

<div class="otp-container">
  <div class="otp-card">
    <div class="row g-0 align-items-stretch">
      
      <!-- Left image/logo section -->
      <div class="col-md-6">
        <div class="image-section">
          <img src="/public/images/brand_logo-new.png" alt="Brand Logo" class="brand">
        </div>
      </div>

      <!-- Right form section -->
      <div class="col-md-6">
        <div class="form-section">
          <div class="form-content">
            <h1 class="otp-title">OTP</h1>
            <p class="otp-subtitle">Enter the OTP sent to your email:</p>
            <p id="emailDisplay"><%= email %></p>
            <div class="timer-text">
              <span id="timer">Remaining: 00:60s</span>
            </div>

            <form id="verifyOtpForm">
              <div class="mb-3">
                <label for="otp" class="form-label">Confirmation Code</label>
                <input 
                  type="text" 
                  maxlength="6" 
                  name="otp" 
                  id="otp" 
                  class="form-control"
                  autocomplete="off"
                  placeholder="Enter 6-digit OTP">
                <div id="otpFeedback" class="invalid-feedback" style="display: none;"></div>
              </div>

              <button type="submit" class="verify-btn">Verify Email</button>
            </form>

            <p class="resend-text">
              Didn't receive an OTP? 
              <button type="button" id="resendOtpBtn" class="btn btn-link p-0 resend-link">Resend Now</button>
            </p>
          </div>

          <div class="footer-brand">MONTRÉA</div>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="/public/js/user/verify-otp.js"></script>
</body>
</html>