<%- include('../partials/user/header') %>
<body>
    <%- include('../partials/user/navbar') %>
    <main>
        <% if (cart.items && cart.items.length === 0) { %>
            <section class="empty-state">
                <svg class="bag-icon" viewBox="0 0 100 100">
                    <path d="M20 30 Q20 20 30 20 H70 Q80 20 80 30 V70 Q80 80 70 80 H30 Q20 80 20 70 Z M40 50 L40 60 M60 50 L60 60" stroke="#f59e0b" stroke-width="4" fill="none"/>
                </svg>
                <h2>Your shopping bag is empty</h2>
                <p>Start filling up your bag!</p>
                <a href="/wishlist" class="btn btn-wishlist">Add items from wishlist</a>
                <a href="/shop" class="btn btn-secondary">Continue shopping</a>
            </section>
        <% } else { %>
            <section class="populated">
                <div class="items-list">
                    <h2>Your Cart</h2>
                    
                    <% if (hasInvalidItems) { %>
                        <div class="alert alert-warning">
                            <div class="alert-content">
                                <div>
                                    <strong>⚠️ Some items are no longer available</strong>
                                    <p>These items cannot be purchased. Please remove them to proceed.</p>
                                </div>
                                <button class="btn-clear-invalid" onclick="clearInvalidItems()">
                                    Clear Invalid Items
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <% if (cart.items && cart.items.length > 0) { %>
                        <% cart.items.forEach((item, index) => { %>
                            <% 
                                let displayPrice, originalPrice, saveAmount, hasDiscount = false;
                                const maxQty = Math.min(5, item.currentStock);
                                
                                // Use calculated price if available (includes offers)
                                if (item.calculatedPrice && !item.isInvalid) {
                                    displayPrice = item.calculatedPrice.displayPrice;
                                    originalPrice = item.calculatedPrice.hasDiscount ? item.calculatedPrice.originalPrice : null;
                                    hasDiscount = item.calculatedPrice.hasDiscount;
                                    saveAmount = hasDiscount ? (originalPrice - displayPrice) * item.quantity : 0;
                                } else if (!item.isInvalid) {
                                    displayPrice = item.discountedPriceAtTime > 0 ? item.discountedPriceAtTime : item.priceAtTime;
                                    originalPrice = item.discountedPriceAtTime > 0 ? item.priceAtTime : null;
                                    saveAmount = originalPrice ? (originalPrice - displayPrice) * item.quantity : 0;
                                    hasDiscount = originalPrice !== null;
                                }
                            %>
                            <div class="item <%= item.isInvalid ? 'item-invalid' : '' %> <%= item.isOutOfStock ? 'item-out-of-stock' : '' %>" 
                                 data-variant-id="<%= item.productVariantId %>"
                                 data-product-id="<%= item.productId %>" 
                                 data-invalid="<%= item.isInvalid %>">
                                
                                <img src="<%= item.productImage %>" 
                                     alt="<%= item.productName %>"
                                     class="item-image"
                                     onerror="this.src='https://via.placeholder.com/100?text=No+Image'">
                                
                                <div class="item-content">
                                    <div class="item-details">
                                        <h3><%= item.productName %></h3>
                                        <div class="variant-info">
                                            Variant: <%= item.size || 'N/A' %> / <%= item.color || 'N/A' %>
                                        </div>
                                        
                                        <% if (!item.isInvalid) { %>
                                            <!-- Offer Badge -->
                                            <% if (item.calculatedPrice && item.calculatedPrice.hasOffer) { %>
                                                <div class="offer-applied-badge">
                                                    <i class="fas fa-tag"></i>
                                                    <%= Math.round(item.calculatedPrice.discountedPercentage) %>% OFF
                                                    <% if (item.calculatedPrice.offerDetails) { %>
                                                        <span class="offer-name">
                                                            (<%= item.calculatedPrice.offerDetails.offerName %>)
                                                        </span>
                                                    <% } %>
                                                </div>
                                            <% } %>

                                            <% if (item.wasAdjusted) { %>
                                            <div class="stock-adjustment-notice">
                                                <i class="fas fa-exclamation-triangle"></i>
                                                Quantity adjusted from <%= item.previousQuantity %> to <%= item.quantity %> due to stock availability
                                            </div>
                                        <% } %>
                                            
                                            <div class="item-price">
                                                <div class="price">₹<%= Math.round(displayPrice) %></div>
                                                <% if (originalPrice) { %>
                                                    <span class="old-price">₹<%= Math.round(originalPrice) %></span>
                                                    <% if (!item.calculatedPrice || !item.calculatedPrice.hasOffer) { %>
                                                        <span class="discount-badge">
                                                            <%= Math.round(((originalPrice - displayPrice) / originalPrice) * 100) %>% OFF
                                                        </span>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        <% } %>
                                        
                                        <% if (item.isInvalid) { %>
                                            <div class="badge badge-invalid">❌ <%= item.invalidReason %></div>
                                        <% } else if (item.isOutOfStock) { %>
                                            <div class="badge badge-out-of-stock">❌ Out of Stock</div>
                                        <% } else if (item.currentStock < 5) { %>
                                            <div class="badge badge-low-stock">📦 Only <%= item.currentStock %> left in stock</div>
                                        <% } %>
                                        
                                        <% if (!item.isInvalid && !item.isOutOfStock && saveAmount > 0) { %>
                                            <div class="save">You save ₹<%= Math.round(saveAmount) %> total</div>
                                        <% } %>
                                    </div>
                                    
                                    <div class="item-right">
                                        <% if (!item.isInvalid && !item.isOutOfStock) { %>
                                            <div class="item-quantity">
                                                <span class="quantity-label">Quantity</span>
                                                <form class="qty-form">
                                                    <input type="hidden" name="productVariantId" value="<%= item.productVariantId %>">
                                                    <div class="qty-controls">
                                                        <button type="button" 
                                                                class="qty-btn qty-decrease" 
                                                                data-variant-id="<%= item.productVariantId %>"
                                                                <%= item.quantity <= 1 ? 'disabled' : '' %>>
                                                            −
                                                        </button>
                                                        <input type="number" 
                                                               name="quantity" 
                                                               value="<%= item.quantity %>" 
                                                               min="1" 
                                                               max="<%= Math.min(5, item.currentStock || 0) %>" 
                                                               class="qty" 
                                                               <%= item.isInvalid || item.isOutOfStock ? 'readonly disabled' : 'readonly' %>>
                                                        <button type="button" 
                                                                class="qty-btn qty-increase" 
                                                                data-variant-id="<%= item.productVariantId %>"
                                                                data-max="<%= maxQty %>"
                                                                <%= item.quantity >= maxQty ? 'disabled' : '' %>>
                                                            +
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        <% } %>
                                        
                                        <div class="item-remove">
                                            <form method="POST" action="/cart/remove" class="remove-form">
                                                <input type="hidden" name="productVariantId" value="<%= item.productVariantId %>">
                                                <button type="submit" class="btn-remove">
                                                    Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No items in cart.</p>
                    <% } %>
                </div>

                <aside class="summary">
                    <h3>Order Summary</h3>
                    
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span>₹<%= Math.round(cart.subtotal) %></span>
                    </div>
                    
                    <% if (hasInvalidItems) { %>
                        <div class="summary-row invalid-items-note">
                            <span><%= cart.totalItems - cart.itemsCount %> unavailable items</span>
                            <span>Not included</span>
                        </div>
                    <% } %>
                    
                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>Calculated at checkout</span>
                    </div>
                    
                    <div class="summary-divider"></div>
                    
                    <p class="note">Taxes and shipping calculated at checkout</p>
                    
                    <% if (cart.totalItems > 0) { %>
                        <% if (canCheckout && cart.itemsCount > 0) { %>
                            <a href="/checkout" class="btn btn-primary checkout-btn">
                                Checkout
                            </a>
                        <% } else { %>
                            <button class="btn btn-primary checkout-btn" disabled>
                                Cannot Proceed
                            </button>
                            <p class="checkout-blocked-msg">
                                Remove unavailable or out-of-stock items to continue
                            </p>
                        <% } %>
                    <% } %>
                    
                    <a href="/shop" class="btn btn-primary continue-shopping">← Continue Shopping</a>
                </aside>
            </section>
        <% } %>
    </main>

    <%- include('../partials/user/footer') %>
    <script>
        const messages = <%- JSON.stringify(messages || []) %>;
        messages.forEach(msg => {
            let bgColor, duration = 3000;
            switch (msg.type) {
                case 'error':
                    bgColor = "linear-gradient(to right, #ff6b6b, #ee5a24)";
                    break;
                case 'success':
                    bgColor = "linear-gradient(to right, #00b09b, #96c93d)";
                    break;
                case 'warning':
                    bgColor = "linear-gradient(to right, #ffa726, #ff7043)";
                    duration = 4000;  
                    break;
                default:
                    bgColor = "linear-gradient(to right, #2196f3, #21cbf3)";
            }
            Toastify({
                text: msg.text,
                duration: duration,
                gravity: "top",
                position: "right",
                backgroundColor: bgColor,
                stopOnFocus: true,
            }).showToast();
        });
    </script>
