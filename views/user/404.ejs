<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap"rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/user/404.css">
    <link rel="stylesheet" href="/public/css/user/index.css">


</head>

<body>
    
     <% if (isAdminRoute) { %>
        <%- include('../partials/admin/header') %>
    <% } else { %>
        <%- include('../partials/user/navbar') %>
    <% } %>

    <div class="content">
        <div>
            <h1 class="display-1">
                <%= statusCode %>
            </h1>
            <h2 class="display-4">
                <%= errorMessage %>
            </h2>
            <a href="<%= backLink %>" class="btn btn-primary mt-3">Go Back</a>
        </div>
    </div>

     <% if (isAdminRoute) { %>
        <%- include('../partials/admin/footer') %>
    <% } else { %>
        <%- include('../partials/user/footer') %>
    <% } %>

    <script src="/public/js/user/index.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
</body>

</html>