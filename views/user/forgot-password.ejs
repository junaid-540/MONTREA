<%- include('../partials/user/header') %>

<body class="d-flex align-items-center justify-content-center vh-100">

    <div class="container">
        <div class="row shadow-lg rounded-4 overflow-hidden">

            <!-- Left side - Image -->
            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center left-bg">
                <img src="/public/images/brand_logo-new.png" alt="MONTRÉA Logo" class="img-fluid p-5">
            </div>

            <!-- Right side - Forgot Password Form -->
            <div class="col-lg-6 col-md-12 bg-white p-5 d-flex flex-column justify-content-center position-relative">
                <div class="form-container">
                    <h5 class="brand-small">MONTRÉA</h5>
                    <h2 class="forgot-title">Forgot Password ?</h2>
                    <p class="forgot-subtitle">Reset your password and get back to shopping in no time!</p>

                    <form id="forgotPasswordForm">
                        <div class="mb-3">
                            <label for="email" class="form-label">Enter your registered email</label>
                            <input type="text" class="form-control" id="email" name="email" autocomplete="email"
                                placeholder="helloworld@gmail.com">
                            <div id="emailFeedback" class="invalid-feedback">Please enter a valid email.</div>
                        </div>

                        <button type="submit" id="verifyBtn" class="btn btn-dark w-100 verify-btn">Verify Email</button>
                    </form>

                    <!-- Error message display -->
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger mt-3">
                            <%= error %>
                        </div>
                        <% } %>

                            <!-- Success message display -->
                            <% if (typeof success !=='undefined' && success) { %>
                                <div class="alert alert-success mt-3">
                                    <%= success %>
                                </div>
                                <% } %>

                                    <p class="back-link mt-3"><a href="/signin">Back to Sign In</a></p>
                </div>

                <div class="text-center mt-4 fw-bold brand-footer">MONTRÉA</div>
            </div>
        </div>
    </div>

    <script>
        const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
        const errorMessage = "<%= typeof errorMessage !== 'undefined' && errorMessage ? errorMessage : '' %>";
    </script>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/public/js/user/forgot-password.js"></script>
</body>

</html>