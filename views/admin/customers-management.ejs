<html>

<%- include('../partials/admin/header') %>
    
    <body>

        <%- include('../partials/admin/sidebar') %>
            <!-- Main Content Area -->
            <main class="content-area">
                <div class="container-fluid py-4">
                    <div class="row mb-4 align-items-center">
                        <div class="col-12 col-md-6 mb-2 mb-md-0">
                            <h2 class="h4 mb-0 fw-bold" style="color: #333;">Customer</h2>
                        </div>
                        <div class="col-12 col-md-6 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                            <form method="GET" action="/admin/customer" class="d-flex gap-2">
                                <input type="text" class="form-control border-start-0" name="search"
                                    placeholder="Search here" value="<%= search || '' %>">
                                <button type="submit" class="btn btn-outline-dark btn-sm search">Search</button>
                                <button type="button" class="btn btn-outline-dark btn-sm clear"
                                    onclick="window.location.href='/admin/customer'">Clear</button>
                            </form>
                        </div>

                    </div>



                    <div class="table-responsive">
                        <table class="table customers-table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="fw-bold text-dark border-top-0">Customer</th>
                                    <th scope="col" class="fw-bold text-dark border-top-0">Email</th>
                                    <th scope="col" class="fw-bold text-dark border-top-0">Phone</th>
                                    <th scope="col" class="fw-bold text-dark border-top-0">Status</th>
                                    <th scope="col" class="fw-bold text-dark border-top-0 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(users.length===0) { %>
                                    <tr>
                                        <td colspan="6" class="text-center">No users found</td>
                                    </tr>
                                    <% } else { %>
                                        <% users.forEach(user=> { %>
                                            <tr>
                                                <td>
                                                    <%= user.name %>
                                                </td>
                                                <!-- <td>
                                                    <%= user._id %>
                                                </td> -->
                                                <td>
                                                    <%= user.email %>
                                                </td>
                                                <td>
                                                    <%= user.phone || '-' %>
                                                </td>
                                                <td>
                                                    <% if(user.status==='active' ) { %>
                                                        <span class="badge bg-success">Active</span>
                                                        <% } else if(user.status==='blocked' ) { %>
                                                            <span class="badge bg-danger">Blocked</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">
                                                                    <%= user.status %>
                                                                </span>
                                                                <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-danger me-1 block-btn"
                                                        data-id="<%= user._id %>" data-name="<%= user.name %>"
                                                        <%=user.status==='blocked' ? 'disabled' : '' %>>
                                                        Block
                                                    </button>

                                                    <button class="btn btn-sm btn-success me-1 unblock-btn"
                                                        data-id="<%= user._id %>" data-name="<%= user.name %>"
                                                        <%=user.status==='active' ? 'disabled' : '' %>>
                                                        Unblock
                                                    </button>
                                                </td>

                                            </tr>
                                            <% }) %>
                                                <% } %>
                            </tbody>

                        </table>
                    </div>

                    <nav aria-label="Customer pagination" class="mt-4">
                        <div class="d-flex justify-content-end">
                            <ul class="pagination mb-0">
                                <% if(currentPage> 1) { %>
                                    <li class="page-item">
                                        <a class="page-link"
                                            href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>">&lt;</a>

                                    </li>
                                    <% } else { %>
                                        <li class="page-item disabled">
                                            <a class="page-link" href="#">&lt;</a>
                                        </li>
                                        <% } %>
                                            <% for(let i=1; i <=totalPages; i++) { %>
                                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                    <a class="page-link"
                                                        href="?page=<%= i %><%= search ? '&search=' + search : '' %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>
                                                    <% if(currentPage < totalPages) { %>
                                                        <li class="page-item">
                                                            <a class="page-link"
                                                                href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>">&gt;</a>
                                                        </li>
                                                        <% } else { %>
                                                            <li class="page-item disabled">
                                                                <a class="page-link" href="#">&gt;</a>
                                                            </li>
                                                            <% } %>
                            </ul>

                        </div>
                    </nav>
                </div>
            </main>

            </div>

            <script>
                const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
            </script>
            <%- include('../partials/admin/footer') %>
    </body>

</html>