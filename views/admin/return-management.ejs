<%- include('../partials/admin/header') %>

<body>
    <%- include('../partials/admin/sidebar') %>

    <!-- Main Content Area -->
    <main class="content-area">
        <div class="return-management-container">
            <!-- Page Header -->
            <div class="page-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="page-title">
                            <i class="fas fa-undo me-2"></i>
                            Return & Refund Management
                        </h2>
                        <p class="page-subtitle">Review and process customer return requests</p>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon stat-requested">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-label">Pending Requests</div>
                        <div class="stat-value"><%= stats.requested || 0 %></div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon stat-approved">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-label">Approved</div>
                        <div class="stat-value"><%= stats.approved || 0 %></div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon stat-rejected">
                            <i class="fas fa-times-circle"></i>
                        </div>
                        <div class="stat-label">Rejected</div>
                        <div class="stat-value"><%= stats.rejected || 0 %></div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon stat-completed">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <div class="stat-label">Refund Completed</div>
                        <div class="stat-value"><%= stats.completed || 0 %></div>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <form method="GET" action="/admin/refund-return" class="filter-controls">
                    <input type="text" class="form-control" name="search" 
                           placeholder="Search by Order ID, Customer Name..." 
                           value="<%= currentSearch %>">
                    
                    <select class="form-select" name="status">
                        <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Status</option>
                        <option value="requested" <%= currentStatus === 'requested' ? 'selected' : '' %>>Requested</option>
                        <option value="approved" <%= currentStatus === 'approved' ? 'selected' : '' %>>Approved</option>
                        <option value="rejected" <%= currentStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
                        <option value="completed" <%= currentStatus === 'completed' ? 'selected' : '' %>>Completed</option>
                    </select>
                    
                    <button type="submit" class="btn btn-filter">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                    
                    <a href="/admin/refund-return" class="btn btn-clear">
                        <i class="fas fa-redo me-2"></i>Clear
                    </a>
                </form>
            </div>

            <!-- Return Requests List -->
            <% if (returnRequests.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-inbox"></i>
                    </div>
                    <div class="empty-text">No return requests found</div>
                </div>
            <% } else { %>
                <% returnRequests.forEach(request => { %>
                    <div class="return-card status-<%= request.returnStatus %>">
                        <div class="return-header">
                            <div class="return-meta">
                                <div class="return-id">
                                    <i class="fas fa-hashtag"></i> <%= request.orderId %>
                                </div>
                                <div class="return-date">
                                    <i class="fas fa-calendar"></i> Requested on: 
                                    <%= new Date(request.returnRequestedAt).toLocaleDateString('en-IN', { 
                                        day: 'numeric', 
                                        month: 'short', 
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </div>
                            </div>
                            <span class="return-status-badge status-badge-<%= request.returnStatus %>">
                                <%= request.returnStatus.charAt(0).toUpperCase() + request.returnStatus.slice(1) %>
                            </span>
                        </div>

                        <div class="return-body">
                            <img src="<%= request.image %>" alt="<%= request.productName %>" 
                                 class="product-image"
                                 onerror="this.src='https://via.placeholder.com/100x120/555/999?text=Product'">
                            <div class="product-details">
                                <h3><%= request.productName %></h3>
                                <div class="product-specs">
                                    <span><i class="fas fa-palette"></i> <%= request.color %></span>
                                    <span><i class="fas fa-ruler"></i> Size: <%= request.size %></span>
                                    <span><i class="fas fa-shopping-cart"></i> Qty: <%= request.quantity %></span>
                                </div>
                                <div class="price-info">
                                    <strong>Refund Amount:</strong> 
                                    <span class="refund-amount">₹<%= Math.round(request.refundAmount) %></span>
                                </div>
                                <div class="customer-info">
                                    <strong>Customer:</strong> 
                                    <%= request.customerName %> | 
                                    <%= request.customerPhone %> | 
                                    <%= request.customerEmail %>
                                </div>
                            </div>
                        </div>

                        <div class="return-reason">
                            <div class="return-reason-title">
                                <i class="fas fa-info-circle"></i>
                                Return Reason
                            </div>
                            <div class="return-reason-text">
                                <%= request.returnReason %>
                            </div>
                        </div>

                        <div class="action-buttons">
                            <% if (request.returnStatus === 'requested') { %>
                                <button class="btn-action btn-approve" 
                                        data-order-id="<%= request.orderId %>"
                                        data-item-id="<%= request.itemId %>">
                                    <i class="fas fa-check"></i>
                                    Approve Return
                                </button>
                                <button class="btn-action btn-reject" 
                                        data-order-id="<%= request.orderId %>"
                                        data-item-id="<%= request.itemId %>">
                                    <i class="fas fa-times"></i>
                                    Reject Return
                                </button>
                            <% } else if (request.returnStatus === 'approved') { %>
                                <button class="btn-action btn-complete" 
                                        data-order-id="<%= request.orderId %>"
                                        data-item-id="<%= request.itemId %>"
                                        data-refund-amount="<%= request.refundAmount %>">
                                    <i class="fas fa-money-bill-wave"></i>
                                    Process Refund
                                </button>
                            <% } %>
                            <a href="/admin/order/<%= request.orderId %>" 
                               class="btn-action btn-view" target="_blank">
                                <i class="fas fa-eye"></i>
                                View Full Order
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <nav aria-label="Return requests pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" 
                                   href="?page=<%= currentPage - 1 %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentStatus ? '&status=' + encodeURIComponent(currentStatus) : '' %>">
                                    &lt;
                                </a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled">
                                <span class="page-link">&lt;</span>
                            </li>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" 
                                   href="?page=<%= i %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentStatus ? '&status=' + encodeURIComponent(currentStatus) : '' %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" 
                                   href="?page=<%= currentPage + 1 %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentStatus ? '&status=' + encodeURIComponent(currentStatus) : '' %>">
                                    &gt;
                                </a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled">
                                <span class="page-link">&gt;</span>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </div>
    </main>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="modalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn" id="confirmActionBtn"></button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/admin/footer') %>

    <script>
        const messages = <%- JSON.stringify(messages || []) %>;
        messages.forEach(msg => {
            let bgColor, duration = 3000;
            switch (msg.type) {
                case 'error':
                    bgColor = "linear-gradient(to right, #ff6b6b, #ee5a24)";
                    break;
                case 'success':
                    bgColor = "linear-gradient(to right, #00b09b, #96c93d)";
                    break;
                case 'warning':
                    bgColor = "linear-gradient(to right, #ffa726, #ff7043)";
                    duration = 4000;
                    break;
                default:
                    bgColor = "linear-gradient(to right, #2196f3, #21cbf3)";
            }
            Toastify({
                text: msg.text,
                duration: duration,
                gravity: "top",
                position: "right",
                backgroundColor: bgColor,
                stopOnFocus: true,
            }).showToast();
        });
    </script>
</body>
</html>