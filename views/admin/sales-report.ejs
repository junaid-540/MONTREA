<html>

<%- include('../partials/admin/header') %>

<body>

    <%- include('../partials/admin/sidebar') %>

    <!-- Main Content Area -->
    <main class="content-area">
        <div class="sales-report-container">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="report-title">Sales Report</h2>
                    <p class="report-subtitle">Track your sales performance and metrics</p>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <form method="GET" action="/admin/sales-report" class="filter-form">
                    <div class="filter-group">
                        <label>Filter Period:</label>
                        <div class="filter-buttons">
                            <button type="submit" name="filterType" value="day" 
                                    class="filter-btn <%= filterType === 'day' ? 'active' : '' %>">
                                Today
                            </button>
                            <button type="submit" name="filterType" value="week" 
                                    class="filter-btn <%= filterType === 'week' ? 'active' : '' %>">
                                This Week
                            </button>
                            <button type="submit" name="filterType" value="month" 
                                    class="filter-btn <%= filterType === 'month' ? 'active' : '' %>">
                                This Month
                            </button>
                            <button type="submit" name="filterType" value="all" 
                                    class="filter-btn <%= filterType === 'all' || !filterType ? 'active' : '' %>">
                                All Time
                            </button>
                            <button type="button" class="clear-filter-btn" onclick="clearAllFilters()">
                                <i class="bi bi-x-circle"></i> Clear Filter
                            </button>
                        </div>
                    </div>

                    <div class="custom-date-section">
                        <label>Custom Date Range:</label>
                        <div class="date-inputs">
                            <input type="date" 
                                id="startDate" 
                                name="startDate" 
                                class="date-input" 
                                value="<%= startDate %>" 
                                max="<%= new Date().toISOString().split('T')[0] %>"
                                placeholder="Start Date">
                            <span>to</span>
                            <input type="date" 
                                id="endDate" 
                                name="endDate" 
                                class="date-input" 
                                value="<%= endDate %>" 
                                max="<%= new Date().toISOString().split('T')[0] %>"
                                placeholder="End Date">
                            <button type="submit" name="filterType" value="custom" class="apply-btn">Apply</button>
                        </div>
                    </div>
                    
                </form>
            </div>

                <!-- Download Buttons -->
                <div class="download-section">
                    <button class="download-btn pdf-btn" onclick="downloadPDF()">
                        <i class="bi bi-file-pdf"></i> Download PDF
                    </button>
                    <button class="download-btn excel-btn" onclick="downloadExcel()">
                        <i class="bi bi-file-excel"></i> Download Excel
                    </button>
                </div>
            </div>

            <!-- Summary Cards -->
            <!--  returns and refunds -->
            <div class="summary-cards">
                <div class="summary-card card-green">
                    <div class="card-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value"><%= totalOrders %></h3>
                        <p class="card-label">Total Orders</p>
                    </div>
                </div>

                <div class="summary-card card-blue">
                    <div class="card-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value">₹<%= totalSales %></h3>
                        <p class="card-label">Total Sales</p>
                    </div>
                </div>

                <div class="summary-card card-orange">
                    <div class="card-icon">
                        <i class="bi bi-tag"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value">₹<%= totalDiscount %></h3>
                        <p class="card-label">Total Discount</p>
                    </div>
                </div>

                <div class="summary-card card-red">
                    <div class="card-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value">₹<%= totalCouponDiscount %></h3>
                        <p class="card-label">Coupon Discount</p>
                    </div>
                </div>

                <div class="summary-card card-purple">
                    <div class="card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value"><%= totalItemsSold %></h3>
                        <p class="card-label">Items Sold</p>
                    </div>
                </div>

                <!--  Returns Card -->
                <div class="summary-card card-cyan">
                    <div class="card-icon">
                        <i class="bi bi-arrow-return-left"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value"><%= totalReturns %></h3>
                        <p class="card-label">Total Returns</p>
                    </div>
                </div>

                <!--  Refunds Card -->
                <div class="summary-card card-pink">
                    <div class="card-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="card-content">
                        <h3 class="card-value">₹<%= totalRefunds %></h3>
                        <p class="card-label">Total Refunds</p>
                    </div>
                </div>
            </div>

            <!-- Financial Breakdown Section -->
            <div class="breakdown-section">
                <h3 class="section-title">
                    <i class="bi bi-calculator"></i> Financial Breakdown
                </h3>
                <div class="breakdown-grid">
                    <div class="breakdown-card">
                        <div class="breakdown-label">Product Subtotal</div>
                        <div class="breakdown-value">₹<%= totalSubtotal %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Product Discounts</div>
                        <div class="breakdown-value text-danger">-₹<%= totalDiscount %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Coupon Discounts</div>
                        <div class="breakdown-value text-danger">-₹<%= totalCouponDiscount %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Shipping Charges</div>
                        <div class="breakdown-value">+₹<%= totalShipping %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Tax (GST 18%)</div>
                        <div class="breakdown-value">+₹<%= totalTax %></div>
                    </div>
                    <div class="breakdown-card highlight">
                        <div class="breakdown-label">Net Revenue</div>
                        <div class="breakdown-value">₹<%= totalSales %></div>
                    </div>
                </div>
            </div>

            <!--  Returns & Cancellations Breakdown Section -->
            <div class="breakdown-section">
                <h3 class="section-title">
                    <i class="bi bi-arrow-counterclockwise"></i> Returns & Cancellations Breakdown
                </h3>
                <div class="breakdown-grid">
                    <div class="breakdown-card">
                        <div class="breakdown-label">Total Cancelled Items</div>
                        <div class="breakdown-value"><%= totalCancellations %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Cancellation Refunds</div>
                        <div class="breakdown-value text-danger">₹<%= totalCancellationAmount %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Total Returned Items</div>
                        <div class="breakdown-value"><%= totalReturns %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Return Refunds</div>
                        <div class="breakdown-value text-danger">₹<%= totalReturnAmount %></div>
                    </div>
                    <div class="breakdown-card highlight">
                        <div class="breakdown-label">Total Refunds Issued</div>
                        <div class="breakdown-value">₹<%= totalRefunds %></div>
                    </div>
                    <div class="breakdown-card">
                        <div class="breakdown-label">Net Revenue (After Refunds)</div>
                        <div class="breakdown-value" style="color: #10b981;">₹<%= totalSales %></div>
                    </div>
                </div>
                
                <div class="calculation-formula">
                    <p><strong>Note:</strong> Total Refunds = Cancellation Refunds (₹<%= totalCancellationAmount %>) + Return Refunds (₹<%= totalReturnAmount %>) = ₹<%= totalRefunds %></p>
                    <p><strong>Revenue Calculation:</strong> Net Revenue already excludes cancelled and returned items, so actual revenue = ₹<%= totalSales %></p>
                </div>
            </div>

            <!-- Payment Method Breakdown Section -->
            <div class="payment-breakdown-section">
                <h3 class="section-title">
                    <i class="bi bi-credit-card"></i> Payment Method Breakdown
                </h3>
                <div class="payment-grid">
                    <% 
                    const paymentMethods = ['COD', 'Wallet', 'Razorpay'];
                    paymentMethods.forEach(method => {
                        const data = paymentBreakdown[method];
                        const percentage = totalOrders > 0 ? ((data.count / totalOrders) * 100).toFixed(1) : 0;
                    %>
                        <div class="payment-card">
                            <div class="payment-header">
                                <div class="payment-icon <%= method.toLowerCase() %>">
                                    <% if (method === 'COD') { %>
                                        <i class="bi bi-cash-coin"></i>
                                    <% } else if (method === 'Wallet') { %>
                                        <i class="bi bi-wallet2"></i>
                                    <% } else { %>
                                        <i class="bi bi-credit-card-2-front"></i>
                                    <% } %>
                                </div>
                                <div class="payment-method-name"><%= method %></div>
                            </div>
                            <div class="payment-stats">
                                <div class="stat-row">
                                    <span class="stat-label">Orders:</span>
                                    <span class="stat-value"><%= data.count %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Transaction Amount:</span>
                                    <span class="stat-value amount">₹<%= Math.round(data.amount) %></span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: <%= percentage %>%"></div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!--  Order Status Breakdown Section -->
            <div class="status-breakdown-section">
                <h3 class="section-title">
                    <i class="bi bi-diagram-3"></i> Order Status Breakdown
                </h3>
                <div class="status-grid">
                    <% 
                    const statusConfig = {
                        'Placed': { color: '#f59e0b', icon: 'bi-cart-plus' },
                        'Processing': { color: '#3b82f6', icon: 'bi-gear' },
                        'Shipped': { color: '#8b5cf6', icon: 'bi-box-seam' },
                        'Out for Delivery': { color: '#06b6d4', icon: 'bi-truck' },
                        'Delivered': { color: '#10b981', icon: 'bi-check-circle' },
                        'Cancelled': { color: '#ef4444', icon: 'bi-x-circle' },
                        'Partially Cancelled': { color: '#f97316', icon: 'bi-dash-circle' },
                        'Partially Delivered': { color: '#84cc16', icon: 'bi-check2-circle' }
                    };

                    Object.entries(statusBreakdown).forEach(([status, count]) => {
                        const config = statusConfig[status] || { color: '#6b7280', icon: 'bi-circle' };
                        const percentage = totalOrders > 0 ? ((count / totalOrders) * 100).toFixed(1) : 0;
                    %>
                        <div class="status-card" style="border-left: 4px solid <%= config.color %>">
                            <div class="status-header">
                                <div class="status-icon" style="background: <%= config.color %>20; color: <%= config.color %>">
                                    <i class="bi <%= config.icon %>"></i>
                                </div>
                                <div class="status-info">
                                    <div class="status-name"><%= status %></div>
                                    <div class="status-count"><%= count %> orders</div>
                                </div>
                            </div>
                            <div class="status-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: <%= percentage %>%; background: <%= config.color %>"></div>
                                </div>
                                <div class="status-percentage"><%= percentage %>%</div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!-- Orders Table -->
            <div class="table-section">
                <h3 class="table-title">Order Details</h3>
                <div class="table-responsive">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Discount</th>
                                <th>Coupon</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (orders.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="text-center no-data">
                                        <i class="bi bi-inbox" style="font-size: 48px; color: #9ca3af;"></i>
                                        <p>No orders found for the selected period</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% orders.forEach((order, index) => { 
                                    const validItems = order.items.filter(item => 
                                        item.itemStatus !== 'Cancelled' && item.itemStatus !== 'Returned'
                                    );
                                    
                                    const cancelledItemsTotal = order.items
                                        .filter(item => item.itemStatus === 'Cancelled')
                                        .reduce((sum, item) => sum + item.itemTotal, 0);
                                    
                                    const returnedItemsTotal = order.items
                                        .filter(item => item.itemStatus === 'Returned')
                                        .reduce((sum, item) => sum + item.itemTotal, 0);
                                    
                                    // Calculate actual amount (excluding cancelled and returned items)
                                    const actualSubtotal = order.subtotal - cancelledItemsTotal - returnedItemsTotal;
                                    
                                    // Calculate proportional coupon discount for valid items only
                                    let actualCouponDiscount = 0;
                                    if (order.couponApplied && order.discountAmount > 0 && actualSubtotal > 0) {
                                        const validItemsRatio = actualSubtotal / order.subtotal;
                                        actualCouponDiscount = Math.round(order.discountAmount * validItemsRatio);
                                    }
                                    
                                    // Calculate proportional product discount for valid items
                                    let actualProductDiscount = 0;
                                    if (order.discount && actualSubtotal > 0) {
                                        const validItemsRatio = actualSubtotal / order.subtotal;
                                        actualProductDiscount = Math.round(order.discount * validItemsRatio);
                                    }
                                    
                                    // Calculate final amount only if there are valid items
                                    let actualAmount = 0;
                                    if (validItems.length > 0) {
                                        const subtotalAfterCoupon = actualSubtotal - actualCouponDiscount;
                                        const actualShipping = subtotalAfterCoupon >= 1000 ? 0 : 50;
                                        const actualTax = Math.round(subtotalAfterCoupon * 0.18);
                                        actualAmount = subtotalAfterCoupon + actualShipping + actualTax;
                                    }
                                    
                                    // Count items sold (only valid items)
                                    const itemsSold = validItems.reduce((sum, item) => sum + item.quantity, 0);
                                %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><strong><%= order.orderId %></strong></td>
                                        <td><%= new Date(order.placedAt).toLocaleDateString('en-IN') %></td>
                                        <td><%= order.userId?.name || 'N/A' %></td>
                                        <td>
                                            <span class="badge badge-payment">
                                                <%= order.paymentMethod %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-status badge-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>">
                                                <%= order.orderStatus %>
                                            </span>
                                        </td>
                                        <td><%= itemsSold %></td>
                                        <td>₹<%= actualProductDiscount %></td>
                                        <td>₹<%= actualCouponDiscount %></td>
                                        <td class="amount-cell">₹<%= Math.round(actualAmount) %></td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <%- include('../partials/admin/footer') %>

    <script>
    const filterType = "<%= filterType %>";
    const startDate = "<%= startDate %>";
    const endDate = "<%= endDate %>";

    function showToast(message, type = 'error') {
        const backgroundColor = type === 'error' ? 'linear-gradient(to right, #ef4444, #dc2626)' : 
                               type === 'success' ? 'linear-gradient(to right, #10b981, #059669)' : 
                               type === 'warning' ? 'linear-gradient(to right, #f59e0b, #d97706)' : 
                               'linear-gradient(to right, #3b82f6, #2563eb)';
        
        Toastify({
            text: message,
            duration: 4000,
            close: true,
            gravity: "top",
            position: "right",
            stopOnFocus: true,
            style: {
                background: backgroundColor,
                borderRadius: "8px",
                padding: "16px 24px",
                fontSize: "14px",
                fontWeight: "500",
                boxShadow: "0 4px 12px rgba(0, 0, 0, 0.15)"
            }
        }).showToast();
    }

    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');
    const today = new Date().toISOString().split('T')[0];

    startDateInput.max = today;
    endDateInput.max = today;

    startDateInput.addEventListener('change', function() {
        const selectedStartDate = this.value;
        if (selectedStartDate) {
            endDateInput.min = selectedStartDate;
            
            if (endDateInput.value && endDateInput.value < selectedStartDate) {
                endDateInput.value = '';
                showToast('End date cleared - it was before the start date', 'error');
            }
        } else {
            endDateInput.min = '';
        }
    });

    endDateInput.addEventListener('change', function() {
        const selectedEndDate = this.value;
        
        if (startDateInput.value && startDateInput.value > selectedEndDate) {
            startDateInput.value = '';
            showToast('Start date cleared - it was after the end date', 'warning');
        }
    });

    // Initialize min/max on page load if dates are already selected
    if (startDate) {
        endDateInput.min = startDate;
    }

    document.getElementById('filterForm').addEventListener('submit', function(e) {
        const filterTypeValue = e.submitter?.value;
        
        if (filterTypeValue === 'custom') {
            const start = startDateInput.value;
            const end = endDateInput.value;
            
            if (!start || !end) {
                e.preventDefault();
                showToast('Please select both start and end dates for custom range', 'error');
                return;
            }
            
            if (start > end) {
                e.preventDefault();
                showToast('Start date cannot be after end date', 'error');
                return;
            }
            
            if (start > today || end > today) {
                e.preventDefault();
                showToast('Dates cannot be in the future', 'error');
                return;
            }
        }
    });

    <% if (messages && messages.length > 0) { %>
        <% messages.forEach(msg => { %>
            showToast("<%= msg.text %>", "<%= msg.type %>");
        <% }); %>
    <% } %>

    function clearAllFilters() {
        // showToast('Filter cleared successfully', 'success');
        setTimeout(() => {
            window.location.href = '/admin/sales-report';
        },0);
    }

    function downloadPDF() {
        let url = `/admin/sales-report/download/pdf?filterType=${filterType}`;
        if (filterType === 'custom' && startDate && endDate) {
            url += `&startDate=${startDate}&endDate=${endDate}`;
        }
        showToast('Generating PDF...', 'info');
        window.location.href = url;
    }

    function downloadExcel() {
        let url = `/admin/sales-report/download/excel?filterType=${filterType}`;
        if (filterType === 'custom' && startDate && endDate) {
            url += `&startDate=${startDate}&endDate=${endDate}`;
        }
        showToast('Generating Excel...', 'info');
        window.location.href = url;
    }
</script>

</body>

</html>