<html>

<%- include('../partials/admin/header') %>

<body>

    <%- include('../partials/admin/sidebar') %>

    <!-- Main Content Area -->
    <main class="content-area">
        <div class="coupons-container">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h2 class="coupons-title">Coupon Management</h2>
                    <p class="products-subtitle">Manage all discount coupons</p>
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <a href="/admin/coupon/add" class="btn btn-dark btn-sm add-coupon-btn">Add Coupon</a>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center mb-4">
                <form method="GET" action="/admin/coupon" class="d-flex gap-2">
                    <input type="text" class="form-control border-start-0 search-input" name="search"
                        placeholder="Search by coupon code..." value="<%= search || '' %>">

                    <button type="submit" class="btn btn-outline-dark btn-sm search">Search</button>
                    <button type="button" class="btn btn-outline-dark btn-sm clear"
                        onclick="window.location.href='/admin/coupon'">Clear</button>

                    <!-- Filter Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-dark btn-sm dropdown-toggle filter" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <%= filter ? filter.charAt(0).toUpperCase() + filter.slice(1) : 'All Status' %>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/admin/coupon<%= search ? '?search=' + encodeURIComponent(search) : '' %>">All Status</a></li>
                            <li><a class="dropdown-item" href="/admin/coupon?filter=active<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Active</a></li>
                            <li><a class="dropdown-item" href="/admin/coupon?filter=inactive<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Inactive</a></li>
                            <li><a class="dropdown-item" href="/admin/coupon?filter=expired<%= search ? '&search=' + encodeURIComponent(search) : '' %>">Expired</a></li>
                        </ul>
                    </div>
                </form>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table coupons-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Discount</th>
                            <th>Min. Purchase</th>
                            <th>Usage</th>
                            <th>Valid Until</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (coupons.length === 0) { %>
                            <tr>
                                <td colspan="9" class="text-center">No coupons found</td>
                            </tr>
                        <% } else { %>
                            <% coupons.forEach((coupon, index) => { %>
                                <%
                                    const now = new Date();
                                    const isExpired = now > new Date(coupon.endDate);
                                    const isActive = coupon.isActive && !isExpired;
                                    const usagePercent = (coupon.usageCount / coupon.usageLimit * 100).toFixed(0);
                                %>
                                <tr>
                                    <td><%= (currentPage - 1) * pageSize + index + 1 %></td>
                                    <td>
                                        <strong><%= coupon.code %></strong>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" 
                                              title="<%= coupon.description %>">
                                            <%= coupon.description %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (coupon.discountType === 'percentage') { %>
                                            <span class="discount-badge">
                                                <%= coupon.discountValue %>% OFF
                                                <% if (coupon.maxDiscountAmount) { %>
                                                    <br><small>(Max ₹<%= coupon.maxDiscountAmount %>)</small>
                                                <% } %>
                                            </span>
                                        <% } else { %>
                                            <span class="discount-badge">₹<%= coupon.discountValue %> OFF</span>
                                        <% } %>
                                    </td>
                                    <td>₹<%= coupon.minPurchaseAmount %></td>
                                    <td>
                                        <div class="usage-info">
                                            <small><%= coupon.usageCount %> / <%= coupon.usageLimit %></small>
                                            <div class="usage-bar">
                                                <div class="usage-progress" style="width: <%= usagePercent %>%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <%= new Date(coupon.endDate).toLocaleDateString('en-IN', { 
                                            day: '2-digit', 
                                            month: 'short', 
                                            year: 'numeric' 
                                        }) %>
                                    </td>
                                    <td>
                                        <% if (isExpired) { %>
                                            <span class="badge badge-expired">Expired</span>
                                        <% } else if (isActive) { %>
                                            <span class="badge badge-active">Active</span>
                                        <% } else { %>
                                            <span class="badge badge-inactive">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-edit" 
                                                data-id="<%= coupon._id %>">
                                            Edit
                                        </button>

                                        <% if (isActive) { %>
                                            <button class="btn btn-sm btn-deactivate" 
                                                    data-id="<%= coupon._id %>" 
                                                    data-code="<%= coupon.code %>">
                                                Deactivate
                                            </button>
                                        <% } else if (!isExpired) { %>
                                            <button class="btn btn-sm btn-activate" 
                                                    data-id="<%= coupon._id %>" 
                                                    data-code="<%= coupon.code %>">
                                                Activate
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav aria-label="Coupon pagination" class="mt-4">
                <div class="d-flex justify-content-end">
                    <ul class="pagination mb-0">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link"
                                    href="?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= filter ? '&filter=' + filter : '' %>">&lt;</a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled">
                                <a class="page-link" href="#">&lt;</a>
                            </li>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link"
                                    href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= filter ? '&filter=' + filter : '' %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link"
                                    href="?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= filter ? '&filter=' + filter : '' %>">&gt;</a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled">
                                <a class="page-link" href="#">&gt;</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </nav>

        </div>
    </main>

    <script>
        const successMessage = "<%= typeof successMessage !== 'undefined' && successMessage ? successMessage : '' %>";
    </script>

    <%- include('../partials/admin/footer') %>
</body>

</html>