<nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
        <a class="navbar-brand text-brown" href="/">MONTRÉA</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/shop">SHOP</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/about">ABOUT US</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/contact">CONTACT US</a>
                </li>
            </ul>
            
            <div class="icon-nav">
                <% if (user && (typeof is404 === 'undefined' || !is404)) { %>
                    
                    <div class="search-container">
                        <form id="searchForm">
                            
                            <span class="search-icon" aria-label="Search">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                </svg>
                            </span>
                            <input type="text" class="search-input" id="searchQuery" placeholder="Search">
                            
                            <button type="button" class="search-clear" id="clearSearch" aria-label="Clear search">
                                <svg viewBox="0 0 24 24">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            </button>
                        </form>
                    </div>
                <% } %>

                
                <div class="profile-dropdown">
                    <button class="icon-nav-item" id="profileDropdown" aria-label="User account">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" />
                        </svg>
                        <% if (user) { %>
                            <span class="login-text"><%= user.name %></span>
                        <% } else { %>
                            <span class="login-text">Login</span>
                        <% } %>
                    </button>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <% if (user) { %>
                            
                            <a href="/profile" class="btn btn-dark">PROFILE</a>
                            <a href="/logout" class="btn btn-dark">LOGOUT</a>
                        <% } else { %>
                           
                            <a href="/signup" class="btn btn-dark">SIGN UP</a>
                            <a href="/signin" class="btn btn-dark">SIGN IN</a>
                        <% } %>
                    </div>
                </div>

               
                <a href="/wishlist" class="icon-nav-item" aria-label="Favorites">
                    <svg viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                    <% if(wishlistItemsCount > 0 ) { %>
                      <span class="wishlist-badge">
                        <%= wishlistItemsCount %>
                      </span>
                   <% } %>
                </a>

                
                <a href="/cart" class="icon-nav-item" aria-label="Shopping cart">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    <% if(cartItemCount > 0) { %>
                       <span class="cart-badge" >
                        <%= cartItemCount %>
                       </span>
                   <% } %>
                </a>
            </div>
        </div>
    </div>
</nav>

<% if (user) { %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Profile Dropdown Functionality
  const profileDropdown = document.getElementById('profileDropdown');
  const dropdownMenu = document.getElementById('dropdownMenu');

  if (profileDropdown && dropdownMenu) {
    profileDropdown.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      dropdownMenu.classList.toggle('show');
    });

    document.addEventListener('click', function(e) {
      if (!profileDropdown.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('show');
      }
    });
  }

  // Search Functionality with Clear Button
  const searchForm = document.getElementById('searchForm');
  const searchInput = document.getElementById('searchQuery');
  const clearButton = document.getElementById('clearSearch');
  const searchIcon = document.querySelector('.search-icon');

  if (searchForm && searchInput && clearButton) {
    // Preserve search query from URL on page load
    const urlParams = new URLSearchParams(window.location.search);
    const searchQuery = urlParams.get('search');
    if (searchQuery) {
      searchInput.value = searchQuery;
    }

    // Show/hide clear button based on input
    function toggleClearButton() {
      if (searchInput.value.trim()) {
        clearButton.classList.add('show');
      } else {
        clearButton.classList.remove('show');
      }
    }

    // Check on page load
    toggleClearButton();

    searchInput.addEventListener('input', toggleClearButton);

    // Clear button functionality
    clearButton.addEventListener('click', function() {
      searchInput.value = '';
      searchInput.focus();
      toggleClearButton();
      
      // Remove search param from URL and reload
      const currentPath = window.location.pathname;
      const params = new URLSearchParams(window.location.search);
      params.delete('search');
      const newUrl = params.toString() ? `${currentPath}?${params.toString()}` : currentPath;
      window.location.href = newUrl;
    });

    // Make magnifying glass clickable (same as submit)
    if (searchIcon) {
      searchIcon.style.cursor = 'pointer';
      searchIcon.style.pointerEvents = 'auto';
      searchIcon.addEventListener('click', function() {
        searchForm.dispatchEvent(new Event('submit'));
      });
    }

    // Search form submission
    searchForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const query = searchInput.value.trim();
      if (!query) return;

      const currentPath = window.location.pathname;
      let redirectUrl = '';

      switch (true) {
        case currentPath === '/' || currentPath === '/home':
          redirectUrl = `/shop?search=${encodeURIComponent(query)}`;
          break;
        case currentPath.startsWith('/shop'):
          const currentParams = new URLSearchParams(window.location.search);
          currentParams.set('search', query);
          redirectUrl = `/shop?${currentParams.toString()}`;
          break;
        case currentPath === '/wishlist':
          redirectUrl = `/wishlist?search=${encodeURIComponent(query)}`;
          break;
        case currentPath.startsWith('/product/'):
          redirectUrl = `/shop?search=${encodeURIComponent(query)}`;
          break;
        case currentPath === '/profile':
          redirectUrl = `/profile?search=${encodeURIComponent(query)}`;
          break;
        default:
          redirectUrl = `/shop?search=${encodeURIComponent(query)}`;
      }

      window.location.href = redirectUrl;
    });

    // Clear on escape
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        searchInput.value = '';
        toggleClearButton();
      }
    });
  }
});
</script>
<% } else { %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const profileDropdown = document.getElementById('profileDropdown');
  const dropdownMenu = document.getElementById('dropdownMenu');

  if (profileDropdown && dropdownMenu) {
    profileDropdown.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      dropdownMenu.classList.toggle('show');
    });

    document.addEventListener('click', function(e) {
      if (!profileDropdown.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('show');
      }
    });
  }
});
</script>
<% } %>